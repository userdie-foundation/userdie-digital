# Copy to a local .env file outside version control; never commit real secrets.
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/userdie_digital
DB_POOL_MAX=10
DATABASE_SSL=false
# Optional exact origin for browser clients; do not use wildcard origins with credentials.
ALLOWED_ORIGIN=https://xn--d1abbl2ben.online

# Generate a separate random secret of at least 32 bytes for login throttling.
# Example: openssl rand -hex 32
LOGIN_RATE_LIMIT_HMAC_KEY=

# Generate a different random secret of at least 32 bytes for recovery throttling.
# Do not reuse LOGIN_RATE_LIMIT_HMAC_KEY.
RECOVERY_RATE_LIMIT_HMAC_KEY=

# Explicit schema migration CLI only. Keep this credential separate from DATABASE_URL.
# For a new, empty staging database only; never use this against an existing DB
# until a baseline/reconciliation review has been completed.
MIGRATIONS_DATABASE_URL=postgresql://migration_owner:password@localhost:5432/userdie_staging
MIGRATIONS_ALLOW_APPLY=false
MIGRATIONS_DATABASE_SSL=false
